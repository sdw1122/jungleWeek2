# Local development defaults. Replace every secret before production deployment.
APP_ENV=development
SITE_ADDRESS=localhost

SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=0
TRUST_PROXY=0
MAX_CONTENT_LENGTH=1048576
FLASK_DEBUG=0

POSTGRES_DB=plant_app
POSTGRES_USER=plant_user
# Use a long hexadecimal value so it can safely be embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-hexadecimal-value

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
